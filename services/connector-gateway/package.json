{
    "name": "@commerce-integration-hub/connector-gateway",
    "private": true,
    "version": "1.1.0-SNAPSHOT",
    "packageManager": "pnpm@11.23.0",
    "type": "module",
    "engines": {
        "node": ">=24 <27"
    },
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "start": "node dist/main.js",
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint .",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:coverage": "vitest run --coverage",
        "generate:openapi": "tsx scripts/export-openapi.ts",
        "check:openapi": "tsx scripts/export-openapi.ts --check",
        "check": "pnpm lint && pnpm type-check && pnpm test:coverage && pnpm check:openapi && pnpm build",
        "db:migrate": "tsx src/database-migrate.ts"
    },
    "dependencies": {
        "@fastify/otel": "0.21.1",
        "@fastify/swagger": "9.8.1",
        "@opentelemetry/api": "1.9.1",
        "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0",
        "@opentelemetry/sdk-node": "0.222.0",
        "@prometheus-io/client": "0.16.1",
        "ajv": "8.20.0",
        "fastify": "5.12.1",
        "jose": "6.2.12",
        "kysely": "0.29.5",
        "pg": "8.23.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@testcontainers/postgresql": "12.1.0",
        "@types/node": "26.4.1",
        "@types/pg": "8.23.1",
        "@vitest/coverage-v8": "4.1.11",
        "eslint": "10.9.1",
        "globals": "17.12.0",
        "tsx": "4.23.13",
        "typescript": "6.0.3",
        "typescript-eslint": "8.69.0",
        "vitest": "4.1.11"
    }
}
