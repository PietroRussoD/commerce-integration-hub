{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "operatorSecurity": {
      "type": "object",
      "required": [
        "enabled",
        "issuer",
        "audience",
        "coreAuthServerUrl",
        "gatewayJwksUrl",
        "clockSkewSeconds"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string" },
        "audience": { "type": "string" },
        "coreAuthServerUrl": { "type": "string" },
        "gatewayJwksUrl": { "type": "string" },
        "clockSkewSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "issuer": {
                "minLength": 1,
                "format": "uri",
                "pattern": "^https?://[^\\s]+$"
              },
              "audience": {
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^\\S(?:.*\\S)?$"
              },
              "coreAuthServerUrl": {
                "minLength": 1,
                "format": "uri",
                "pattern": "^https?://[^\\s]+$"
              },
              "gatewayJwksUrl": {
                "minLength": 1,
                "format": "uri",
                "pattern": "^https?://[^\\s]+$"
              }
            }
          }
        }
      ]
    }
  }
}
