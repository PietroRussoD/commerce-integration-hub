{
    "name": "@commerce-integration-hub/provider-simulator",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@11.23.0",
    "type": "module",
    "engines": {
        "node": ">=24 <27"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "check": "pnpm lint && pnpm type-check && pnpm test:coverage && pnpm build",
        "dev": "tsx watch src/main.ts",
        "lint": "eslint .",
        "start": "node dist/main.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "fastify": "5.12.8"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "4.1.12",
        "eslint": "10.15.0",
        "globals": "17.14.0",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "vitest": "4.1.12"
    }
}
